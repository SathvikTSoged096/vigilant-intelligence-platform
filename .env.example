APP_NAME=Vigilant Intelligence Platform
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=["http://localhost"]
POSTGRES_DB=gotham
POSTGRES_USER=gotham
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql+asyncpg://gotham:replace-me@localhost:5432/gotham
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
AI_TEMPERATURE=0.1
GEMINI_API_KEY=GEMINI_API_KEY
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
